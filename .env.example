# Database settings
DB_TYPE=sqlite  # sqlite, postgresql, mysql
DB_NAME=ecommerce.db
DB_USER= 
DB_PASSWORD=
DB_HOST=  # localhost for PostgreSQL/MySQL, leave empty for SQLite
DB_PORT=  # 5432 for PostgreSQL, 3306 for MySQL, leave empty for SQLite

# For PostgreSQL: postgresql://user:password@localhost:5432/dbname
# For MySQL: mysql+pymysql://user:password@localhost:3306/dbname
# For SQLite: sqlite:///ecommerce.db

# Complete connection string (will be constructed if empty)
DATABASE_URL=

# Google API
GOOGLE_API_KEY=your_api_key_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_HOURS=24